# =============================================================================
# FlytBase Asset Intelligence Copilot - Environment Configuration
# =============================================================================

# PostgreSQL & pgvector Database Configuration
POSTGRES_USER=aic_user
POSTGRES_PASSWORD=aic_password
POSTGRES_DB=asset_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Inside docker compose, use postgresql://aic_user:aic_password@postgres:5432/asset_intelligence
POSTGRES_DSN=postgresql://aic_user:aic_password@localhost:5432/asset_intelligence

# Neo4j Spatio-Temporal Graph Database
# Inside docker compose: bolt://neo4j:7687
# Outside docker compose (local): bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aic_graph_password
NEO4J_DATABASE=neo4j

# Redis Cache & Celery Message Broker
# Inside docker compose: redis://redis:6379/0 and redis://redis:6379/1
# Outside docker compose (local): redis://localhost:6379/0 and redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI & LLM Service Keys (Optional - fallbacks are provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
THESYS_API_KEY=

# Benchmark Reference Date ("Today" in evaluation; defaults to latest inspection date)
AS_OF_DATE=2026-10-17

# Frontend Backend Proxy Target
BACKEND_URL=http://localhost:8000

# Path to Dataset
DATASET_PATH=C:\Users\Priyanshu Patil\Documents\program01\flytbase\flytbase-ahc-swe-asset-intelligence-dataset\sample-data
